# ══════════════════════════════════════════════
#  MODÈLE DE SECRETS — copier, remplir, NE PAS COMMITER
# ══════════════════════════════════════════════
#
# En ligne  : Streamlit Cloud > l'app > Settings > Secrets,
#             coller le bloc [github] ci-dessous (sans ces commentaires).
# En local  : cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#             puis remplir. Le fichier est ignoré par git.
#
# Sans ces secrets, l'app fonctionne : le bouton « Commiter ces
# termes » n'apparaît simplement pas, et le lexique se règle à chaud
# comme avant.

[github]

# Jeton d'accès personnel FINE-GRAINED. À créer sur :
#   github.com > Settings > Developer settings
#     > Personal access tokens > Fine-grained tokens > Generate new
#
#   Repository access ... Only select repositories -> Devis-generator
#   Permissions ....... Repository permissions > Contents
#                        -> Read and write   (celle-là et AUCUNE autre)
#   Expiration ........ 90 jours, à renouveler
#
# ⚠️ PAS un jeton « classic » à portée `repo` : il donnerait
#    l'écriture sur TOUS les dépôts du compte — y compris
#    pv-explorer-app — pour une fonction qui n'écrit qu'un fichier.
token = "github_pat_REMPLACER_PAR_LE_VOTRE"

# Au format « proprietaire/depot », tel qu'il apparaît dans l'URL.
depot = "pmeyssonnier/Devis-generator"

# Branche où écrire. L'app se redéploie depuis main.
branche = "main"
